    "allow-add-google-account",
    "allow-cancel-add-account",
    "allow-remove-account",
    "allow-reauth-account",
    "allow-set-account-policy",
    "allow-set-account-visible",
    "allow-agenda",
    "allow-set-event-recording",
    "allow-join-and-record",
    "allow-join-without-recording",
    "allow-connections",
    "allow-toggle-want",
