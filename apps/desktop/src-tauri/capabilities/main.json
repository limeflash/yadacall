    "allow-recorder-start",
    "allow-recorder-pause",
    "allow-recorder-resume",
    "allow-recorder-stop",
    "allow-recorder-cancel",
    "allow-recorder-bookmark",
    "allow-list-input-devices",
    "allow-search",
    "allow-ask",
    "allow-list-tasks",
    "allow-import-audio",
    "allow-list-imports",
