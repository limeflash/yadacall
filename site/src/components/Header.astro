---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import LangToggle from './LangToggle.astro';
import { T, type Lang } from '../lib/i18n';
import { X } from '../lib/strings';
import { REPO, href } from '../lib/site';

interface Props {
  lang: Lang;
  landing: boolean;
  paths: { ru: string; en: string };
  current: Lang;
}
const { lang, landing, paths, current } = Astro.props;
const t = T[lang];
const home = href(lang === 'en' ? '/en/' : '/');
// On the landing the links are in-page anchors (as in the design); on other pages they go to the landing.
const a = (hash: string) => (landing ? hash : `${home}${hash}`);
---
<header id="yl-nav" style="position: sticky; top: 0; z-index: 50; background: transparent; border-bottom: 1px solid transparent; -webkit-backdrop-filter: none; backdrop-filter: none; transition: background-color .35s, border-color .35s">
  <div style="max-width: 1180px; margin: 0 auto; box-sizing: border-box; height: 68px; padding: 0 clamp(16px, 4vw, 40px); display: flex; align-items: center; gap: clamp(14px, 2.4vw, 28px)">
    <a href={landing ? '#top' : home} aria-label="YadaCall" style="flex: none; display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--text)">
      <span style="display: block; width: 34px; height: 34px"><Mark eager /></span>
      <span style="font-size: 18px; font-weight: 800; letter-spacing: -0.03em">yada<span style="color: var(--accent-text)">call</span></span>
    </a>
    <nav class="yl-navlinks" aria-label={t.navLabel} style="display: flex; gap: 24px; font-size: 14px; white-space: nowrap">
      <a class="yl-link" href={a('#features')}>{t.navFeatures}</a>
      <a class="yl-link" href={a('#privacy')}>{t.navPrivacy}</a>
      <a class="yl-link" href={a('#models')}>{t.navModels}</a>
      <a class="yl-link" href={a('#oss')}>{X[lang].ossLink}</a>
    </nav>
    <span style="flex: 1"></span>
    <LangToggle lang={lang} label={t.langLabel} paths={paths} current={current} />
    <a class="yl-link yl-gh" href={REPO} style="display: inline-flex; align-items: center; gap: 6px; font-size: 14px">GitHub<Icon name="externalLink" size={12} /></a>
    <a class="yl-btn" href={a('#download')} style="flex: none; display: inline-flex; align-items: center; height: 38px; padding: 0 16px; border-radius: 12px; background: var(--accent); color: var(--ink-on-accent); font-size: 14px; font-weight: 800; text-decoration: none">{t.navDownload}</a>
  </div>
</header>
